@model TelemetryPageVm
@{ ViewData["Title"] = "Telemetry"; }

<h2>Sensor telemetry</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input name="farmId" value="@Model.FarmId" class="form-control" placeholder="farm id" /></div>
    <div class="col-auto"><button class="btn btn-outline-success">Load</button></div>
</form>

@if (User.IsInRole("Admin") || User.IsInRole("Technician"))
{
    <form asp-action="Send" method="post" class="row g-2 mb-4">
        <input type="hidden" name="farmId" value="@Model.FarmId" />
        <div class="col-auto"><input type="number" name="count" value="25" min="1" max="100" class="form-control" /></div>
        <div class="col-auto"><button class="btn btn-success">Send test readings</button></div>
        <div class="col-auto align-self-center text-muted small">Posts to the HTTP function &rarr; queue &rarr; Table Storage</div>
    </form>
}

<table class="table table-sm table-striped">
    <thead><tr><th>Time (UTC)</th><th>Sensor</th><th>Type</th><th>Moisture %</th><th>Temp &deg;C</th><th>pH</th><th>Notes</th></tr></thead>
    <tbody>
    @foreach (var r in Model.Readings)
    {
        <tr class="@(r.EventType == "alert" ? "table-danger" : "")">
            <td>@r.ReadingTimeUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
            <td>@r.SensorId</td>
            <td>@r.EventType</td>
            <td>@r.SoilMoisture.ToString("0.0")</td>
            <td>@r.SoilTemperature.ToString("0.0")</td>
            <td>@r.Ph.ToString("0.0")</td>
            <td>@r.Notes</td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Readings.Any())
{
    <p class="text-muted">No data for this farm yet.</p>
}
