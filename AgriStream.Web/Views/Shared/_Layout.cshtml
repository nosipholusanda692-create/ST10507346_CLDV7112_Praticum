<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AgriStream IoT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">AgriStream IoT</a>
        <ul class="navbar-nav me-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Telemetry" asp-action="Index">Telemetry</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Media" asp-action="Index">Media</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Users</a></li>
                }
            }
        </ul>
        <ul class="navbar-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item d-flex align-items-center text-white me-3">
                    @User.Identity!.Name (@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value))
                </li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                </li>
            }
            else
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
            }
        </ul>
    </div>
</nav>

<main class="container py-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</main>

<footer class="text-center text-muted py-3 border-top">AgriStream IoT &copy; @DateTime.UtcNow.Year</footer>
</body>
</html>
